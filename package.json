{
  "name": "vue3-drag-drop",
  "description": "Lightweight, zero-dependency Vue 3 drag and drop library using native HTML5 Drag and Drop API. Drag & Drop components for Vue 3 and Nuxt 3.",
  "version": "1.2.2",
  "license": "MIT",
  "author": "Tushar Ghosh Joy <tusharghoshjoy@gmail.com> (https://www.tusharjoy.com)",
  "homepage": "https://tusharjoy.github.io/vue3-drag-drop/",
  "bugs": {
    "url": "https://github.com/TusharJoy/vue3-drag-drop/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TusharJoy/vue3-drag-drop.git"
  },
  "private": false,
  "types": "./types/index.d.ts",
  "files": [
    "dist",
    "types"
  ],
  "main": "./dist/vue3-drag-drop.umd.js",
  "module": "./dist/vue3-drag-drop.es.js",
  "exports": {
    ".": {
      "import": "./dist/vue3-drag-drop.es.js",
      "require": "./dist/vue3-drag-drop.umd.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --config vite.demo.config.js",
    "preview": "vite preview"
  },
  "keywords": [
    "vue",
    "vue3",
    "vue-drag-drop",
    "vue3-drag-drop",
    "drag-and-drop",
    "drag and drop",
    "drag",
    "drop",
    "draggable",
    "vue-draggable",
    "vuedraggable",
    "dnd",
    "vue-dnd",
    "vue3-dnd",
    "html5-drag-and-drop",
    "native-drag-drop",
    "composition-api",
    "vue-component",
    "drag-drop",
    "nuxt",
    "nuxt3",
    "sortable",
    "kanban",
    "touch-friendly"
  ],
  "peerDependencies": {
    "vue": "^3.2.45"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.0.0",
    "vite": "^4.0.0",
    "vue": "^3.2.45"
  }
}
